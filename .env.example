# BRANDSense Enterprise Configuration

# Next.js Public Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend FastAPI Environment Variables (Never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-validation
BACKEND_CORS_ORIGINS=http://localhost:3000,https://brandsense.yourdomain.com
# AI Model Integration (NVIDIA Nemotron / Gemini / OpenAI)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_NAME=nvidia/nemotron-4-340b-instruct
PORT=8000

