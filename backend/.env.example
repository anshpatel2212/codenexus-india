# ==============================================================================
# BrandSense FastAPI Backend Environment Example
# Copy to backend/.env and populate with your project credentials
# ==============================================================================

# Core Supabase Infrastructure
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Legacy HS256 secret (used strictly for backward-compatible HS256 tokens)
SUPABASE_JWT_SECRET=YOUR_LEGACY_JWT_SECRET
SUPABASE_LEGACY_HS256_SECRET=
# Optional overrides for ECC P-256 (automatically derived from SUPABASE_URL if omitted):
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
ENVIRONMENT=development

# Backend CORS Configuration
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI Engine Configuration (Maintained by AI Engineer)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
GEMINI_API_KEY=
OPENAI_API_KEY=

